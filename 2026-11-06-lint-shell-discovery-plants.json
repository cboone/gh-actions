{
  "inputs": [".github/workflows/lint-shell.yml", "tests/check-shell-discovery.py", "docs/reviews/2026-11-06-lint-shell-discovery-plants/comment.patch", "docs/reviews/2026-11-06-lint-shell-discovery-plants/partial-manifest.patch", "docs/reviews/2026-11-06-lint-shell-discovery-plants/check.py", "docs/reviews/2026-11-06-lint-shell-discovery-plants/skipped-count.patch", "docs/reviews/2026-11-06-lint-shell-discovery-plants/preflight.sh", "docs/reviews/2026-11-06-lint-shell-discovery-plants/check.sh", "docs/reviews/2026-11-06-lint-shell-discovery-plants/measured-notice.patch", "docs/reviews/2026-11-06-lint-shell-discovery-plants/inventory.json", "docs/reviews/2026-11-06-lint-shell-discovery-plants/fallback-manifest.patch"],
