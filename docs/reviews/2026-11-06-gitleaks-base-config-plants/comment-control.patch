--- a/.github/workflows/scan-for-secrets.yml
+++ b/.github/workflows/scan-for-secrets.yml
@@ -202,7 +202,7 @@
             trusted_args=(--config "${trusted_dir}/config-0.toml" \
               --gitleaks-ignore-path "${trusted_dir}/.gitleaksignore")
             args+=("${trusted_args[@]}")
