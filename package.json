{
  "private": true,
  "name": "gh-actions",
  "description": "A collection of reusable GitHub Actions for CI/CD workflows.",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\"",
    "spell": "cspell .",
    "spell:list": "cspell . --unique --words-only --no-progress"
  },
  "devDependencies": {
    "cspell": "10.3.0",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6"
  },
  "overrides": {
    "smol-toml": "1.7.2"
  }
}
